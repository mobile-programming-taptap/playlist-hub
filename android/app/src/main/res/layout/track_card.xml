<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="2dp">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:nestedScrollingEnabled="true" android:scrollbars="vertical" android:fadeScrollbars="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <FrameLayout android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="120dp" android:importantForAccessibility="no">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="♪" android:textSize="72sp" android:gravity="center" android:textColor="#FFFFFF" android:fontFamily="sans-serif-light" android:importantForAccessibility="no" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/edit_result" style="@style/TapTap.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="8dp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="곡 수정" android:textSize="12sp" android:textColor="@color/ink" app:backgroundTint="@color/surface" app:strokeColor="@color/line" app:cornerRadius="12dp" />
                </FrameLayout>
                <TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true" android:textSize="22sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/muted" />
                <TextView android:id="@+id/track_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/teal" />
                <TextView android:id="@+id/reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:breakStrategy="balanced" />
                <com.google.android.material.button.MaterialButton android:id="@+id/listen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="▶ YouTube로 듣기" android:textSize="14sp" android:textColor="@color/teal" app:backgroundTint="@color/soft_teal" app:cornerRadius="14dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/external" style="@style/TapTap.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginEnd="8dp" android:text="외부에서 열기" android:textSize="13sp" app:strokeColor="@color/line" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="목록에 저장" android:textSize="13sp" android:textColor="@color/accent" app:backgroundTint="@color/soft_accent" app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
