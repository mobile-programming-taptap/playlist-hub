<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="2dp" android:paddingBottom="12dp">
    <View android:layout_width="match_parent" android:layout_height="28dp" android:layout_gravity="bottom" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:background="@drawable/card_stack" android:importantForAccessibility="no" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="6dp" app:cardBackgroundColor="@color/card_surface" app:cardCornerRadius="24dp" app:cardElevation="3dp" app:strokeWidth="0dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:nestedScrollingEnabled="true" android:scrollbars="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <FrameLayout android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="240dp" android:background="@color/card_surface">
                    <ImageView android:id="@+id/track_artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/ic_artwork_placeholder" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="12dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/photo_badge" android:text="YouTube · 곡 이미지" android:textColor="#FFFFFF" android:textSize="10sp" android:importantForAccessibility="no" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/edit_result" style="@style/TapTap.Outlined" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="10dp" android:minWidth="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="곡 수정" android:textSize="12sp" android:textColor="@color/ink" app:icon="@drawable/ic_edit" app:iconSize="16dp" app:iconTint="@color/ink" app:backgroundTint="@color/surface" app:strokeWidth="0dp" app:cornerRadius="24dp" />
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
                    <TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true" android:textSize="22sp" android:textColor="@color/card_ink" android:fontFamily="@font/pretendard_semibold" app:fontFamily="@font/pretendard_semibold" />
                    <TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/card_muted" />
                    <TextView android:id="@+id/track_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="@color/card_teal" />
                    <TextView android:id="@+id/reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:textSize="13sp" android:textColor="@color/card_muted" android:lineSpacingExtra="2dp" android:breakStrategy="balanced" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.google.android.material.button.MaterialButton android:id="@+id/external" style="@style/TapTap.CardAction" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="다른 앱" app:icon="@drawable/ic_external" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/TapTap.CardAction" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="목록에 저장" app:icon="@drawable/ic_save" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
