<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:focusableInTouchMode="true" android:importantForAccessibility="no" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/discover_background">
    <FrameLayout android:id="@+id/app_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingStart="16dp" android:paddingEnd="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_gravity="center" android:layout_marginStart="48dp" android:layout_marginEnd="48dp" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/notice" android:visibility="gone" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:accessibilityLiveRegion="polite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/discover_muted" android:textSize="11sp" />
            <TextView android:id="@+id/header_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="하루를 닮은 음악" android:textSize="11sp" android:textColor="@color/discover_muted" />
            <TextView android:id="@+id/header_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TapTap" android:textColor="@color/discover_ink" android:textSize="16sp" android:fontFamily="@font/pretendard_semibold" app:fontFamily="@font/pretendard_semibold" />
        </LinearLayout>
        <TextView android:id="@+id/counter" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:gravity="center" android:textColor="@color/discover_muted" android:textSize="11sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:contentDescription="설정 및 반응 관리" app:icon="@drawable/ic_settings" app:iconTint="@color/discover_ink" />
    </FrameLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:visibility="invisible" app:indicatorColor="@color/deck_accent" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/recommend_page" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <androidx.core.widget.NestedScrollView android:id="@+id/recommend_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
                    <LinearLayout android:id="@+id/request_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="32dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_title" android:textSize="28sp" android:textColor="@color/discover_ink" android:fontFamily="@font/pretendard_semibold" app:fontFamily="@font/pretendard_semibold" android:lineSpacingExtra="3dp" />
                        <TextView android:id="@+id/mode_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="24dp" android:text="듣고 싶은 순간을 한 문장으로 적어주세요." android:textSize="13sp" android:textColor="@color/discover_muted" />
                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/prompt_layout" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="어떤 음악이 듣고 싶나요?" app:counterEnabled="true" app:counterMaxLength="500" app:counterTextColor="@color/card_ink" app:hintTextColor="#35424A" app:boxBackgroundColor="#EEFFFFFF" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="3" android:maxLines="5" android:maxLength="500" android:inputType="textMultiLine|textCapSentences" android:gravity="top" android:textSize="16sp" android:textColor="#172127" android:textColorHint="#35424A" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.chip.ChipGroup android:id="@+id/examples" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="6dp">
                            <com.google.android.material.chip.Chip android:id="@+id/example_rain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="비 오는 밤" app:ensureMinTouchTargetSize="true" app:chipBackgroundColor="#EFFFFFFF" android:textColor="#172127" />
                            <com.google.android.material.chip.Chip android:id="@+id/example_study" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="집중할 때" app:ensureMinTouchTargetSize="true" app:chipBackgroundColor="#EFFFFFFF" android:textColor="#172127" />
                            <com.google.android.material.chip.Chip android:id="@+id/example_workout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="신나는 운동" app:ensureMinTouchTargetSize="true" app:chipBackgroundColor="#EFFFFFFF" android:textColor="#172127" />
                        </com.google.android.material.chip.ChipGroup>
                        <com.google.android.material.button.MaterialButton android:id="@+id/recommend" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="새로운 음악 발견하기" android:textSize="15sp" android:textColor="@color/deck_surface" app:backgroundTint="@color/deck_accent" app:cornerRadius="28dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="12dp">
                        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="460dp" />
                        <LinearLayout android:id="@+id/results_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" >
                                <com.google.android.material.button.MaterialButton android:id="@+id/edit_request" style="@style/TapTap.DeckTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="요청 수정" android:textSize="11sp" app:icon="@drawable/ic_settings" app:iconSize="14dp" />
                                <com.google.android.material.button.MaterialButton android:id="@+id/save_results" style="@style/TapTap.DeckTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="모두 저장" android:textSize="11sp" app:icon="@drawable/ic_save" app:iconSize="14dp" />
                            </LinearLayout>
                <TextView android:id="@+id/condition_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:maxWidth="280dp" android:maxLines="2" android:gravity="center" android:background="@drawable/photo_badge" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:padding="20dp" android:text="@string/home_empty" android:textColor="#FFFFFF" android:textSize="14sp" android:lineSpacingExtra="4dp" android:gravity="center" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout android:id="@+id/card_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="14dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                    <com.google.android.material.button.MaterialButton android:id="@+id/previous" style="@style/TapTap.Control" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="이전 곡" app:icon="@drawable/ic_previous" app:iconTint="@color/deck_muted" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/dislike" style="@style/TapTap.Control" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="6dp" android:contentDescription="싫어요" app:icon="@drawable/ic_dislike" app:iconTint="@color/dislike_red" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/listen" style="@style/TapTap.Control" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="6dp" android:contentDescription="현재 곡 YouTube로 듣기" app:icon="@drawable/ic_play" app:iconTint="#FFFFFF" app:iconSize="30dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/like" style="@style/TapTap.Control" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="6dp" android:contentDescription="좋아요" app:icon="@drawable/ic_heart" app:iconTint="@color/like_green" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/next" style="@style/TapTap.Control" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:contentDescription="다음 곡" app:icon="@drawable/ic_next" app:iconTint="@color/deck_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/library_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true" android:background="@color/background">
            <LinearLayout android:id="@+id/library" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@color/deck_surface" app:itemIconTint="@color/deck_navigation" app:itemTextColor="@color/deck_navigation" app:itemIconSize="22dp" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" app:elevation="0dp" />
</LinearLayout>
