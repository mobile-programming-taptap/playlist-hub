<?xml version="1.0" encoding="utf-8"?>
<!-- Imported track: the shared 내 목록 row; tapping it reveals the edit fields in import_body. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <include android:id="@+id/import_header" layout="@layout/item_media_row" />
    <TextView android:id="@+id/import_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="100dp" android:layout_marginBottom="4dp" android:background="@drawable/review_badge"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="곡명과 아티스트를 확인해 주세요." android:textColor="@color/deck_accent" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/import_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="12dp" android:visibility="gone" />
</LinearLayout>
