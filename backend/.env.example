# Copy into backend/.env; never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PUBLIC_BASE_URL=https://your-domain.example
# HTTPS deployment: domain must resolve to the server. Use a new private DB password.
DOMAIN=
# Optional locally; a monitored operator mailbox is required before accepting public deletion requests.
# Shown on the home/privacy pages and used for the account-deletion mail draft. No mail is sent by the server.
SUPPORT_EMAIL=
# Optional operator-only report review API; 32–256 URL-safe letters/digits/_/-. Never put this in the Android app or a URL.
# Empty/invalid: user reports remain saved as OPEN; operator review endpoints return 503.
MODERATION_ADMIN_SECRET=
# Numeric Kakao Developers app ID; not a Native App Key or REST API key.
KAKAO_APP_ID=
DATABASE_USER=taptap
DATABASE_PASSWORD=
# Generate 32 random bytes, Base64 encoded; keep stable for stored connections.
PLATFORM_TOKEN_SECRET=
# Spotify uses PKCE; no client secret is sent.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://your-domain.example/connections/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/connections/youtube/callback
YOUTUBE_API_KEY=
